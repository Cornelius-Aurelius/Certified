:root{--bg:#03070b;--bg2:#07111a;--panel:#09141e;--panel2:#0d1b27;--text:#f6fbff;--muted:#9eb2c1;--line:#1e3d50;--cyan:#24d8ff;--cyan2:#00aecd;--gold:#ffbf47;--max:1380px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--text);background:radial-gradient(circle at 50% 15%,rgba(36,216,255,.07),transparent 28%),linear-gradient(180deg,var(--bg),var(--bg2) 42%,var(--bg));font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}img,video{max-width:100%}button{font:inherit}.wrap{width:min(var(--max),calc(100% - 40px));margin-inline:auto}.hero{height:100vh;height:100svh;min-height:560px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#02070b}.hero img{display:block;height:100%;width:auto;max-width:100%;object-fit:contain;object-position:center}@media(max-aspect-ratio:3/2){.hero img{width:100%;height:100%;object-fit:contain}}.proof-nav{position:sticky;top:0;z-index:40;border-top:1px solid #102531;border-bottom:1px solid #17303f;background:rgba(3,7,11,.92);backdrop-filter:blur(16px)}.proof-nav .wrap{min-height:64px;display:flex;align-items:center;gap:18px}.brand{font-size:12px;font-weight:900;letter-spacing:.12em;white-space:nowrap}.brand span{color:var(--cyan)}.navlinks{margin-left:auto;display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px}.navlinks a,.site-link{color:#c9d7e1;text-decoration:none;font-size:11px;padding:8px 10px;border:1px solid transparent;border-radius:999px}.navlinks a:hover,.site-link:hover{border-color:#28566c;color:#fff}.site-link{border-color:#28566c;color:#fff}.intro{padding:88px 0 62px}.eyebrow{color:var(--cyan);text-transform:uppercase;letter-spacing:.18em;font-size:10px;font-weight:900}.intro h1{max-width:980px;margin:12px 0 20px;font-size:clamp(42px,6vw,84px);line-height:.98;letter-spacing:-.055em}.intro h1 em{color:var(--cyan);font-style:normal}.intro .lead{max-width:880px;margin:0;color:#c6d5df;font-size:clamp(17px,2vw,22px);line-height:1.65}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:42px}.principle{padding:22px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(180deg,rgba(13,27,39,.72),rgba(7,17,26,.72))}.principle strong{display:block;font-size:15px;margin-bottom:6px}.principle span{color:var(--muted);font-size:12px;line-height:1.55}section.content-section{padding:52px 0 90px;border-top:1px solid rgba(31,61,80,.55)}.section-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.6fr);gap:32px;align-items:end;margin-bottom:30px}.section-head h2{font-size:clamp(34px,5vw,64px);line-height:1;letter-spacing:-.05em;margin:8px 0 0}.section-head p{margin:0;color:var(--muted);font-size:13px;line-height:1.7}.number{color:var(--cyan);font-weight:900;font-size:11px;letter-spacing:.14em}.learning-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}.learning-card{min-height:210px;padding:20px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(180deg,#0c1924,#07111a)}.learning-index{font-size:10px;font-weight:900;letter-spacing:.14em;color:var(--cyan);margin-bottom:30px}.learning-card h3{font-size:22px;margin:0 0 10px;letter-spacing:-.03em}.learning-card p{margin:0;color:var(--muted);font-size:12px;line-height:1.65}.certificate-grid,.video-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;align-items:start}.certificate-card,.video-card{overflow:hidden;border:1px solid var(--line);border-radius:20px;background:linear-gradient(180deg,#0a151f,#07111a);box-shadow:0 18px 52px rgba(0,0,0,.20)}.certificate-card.priority{border-color:#245c72;box-shadow:0 18px 52px rgba(0,0,0,.2),inset 0 1px rgba(36,216,255,.06)}.image-button{display:block;width:100%;padding:0;border:0;background:#fff;cursor:zoom-in;line-height:0;overflow:hidden}.image-button img{display:block;width:100%;height:auto;object-fit:contain;object-position:center}.certificate-copy{padding:18px 20px 22px;border-top:1px solid var(--line)}.tag{display:inline-flex;align-items:center;min-height:24px;padding:4px 8px;border:1px solid #25566c;border-radius:999px;color:var(--cyan);font-size:9px;font-weight:900;letter-spacing:.11em;text-transform:uppercase}.certificate-copy h3{margin:10px 0 7px;font-size:clamp(18px,2.2vw,25px);line-height:1.22;letter-spacing:-.025em}.certificate-copy p{margin:0;color:var(--muted);font-size:12px;line-height:1.5}.video-shell{width:100%;background:#fff;line-height:0}.video-shell video{display:block;width:100%;height:auto;object-fit:contain;object-position:center;background:#fff}.evidence-note{margin:0 0 26px;padding:18px 20px;border-left:3px solid var(--cyan);background:#08131c;color:#bdd0dc;font-size:13px;line-height:1.7;border-radius:0 14px 14px 0}.evidence-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;align-items:start}.evidence-image{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff}.evidence-image img{width:100%;height:auto;display:block;object-fit:contain}.back-links{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:30px}.back-links a{display:flex;align-items:center;justify-content:space-between;min-height:64px;padding:16px 18px;border:1px solid #28566c;border-radius:16px;color:#e8f7ff;text-decoration:none;background:#08131c;font-size:13px;font-weight:800}.back-links a span{color:var(--cyan)}.back-links a:hover{background:#0b1a25}.closing{padding:90px 0 110px;text-align:center}.closing blockquote{max-width:900px;margin:0 auto;font-size:clamp(28px,4vw,54px);line-height:1.13;letter-spacing:-.045em;font-weight:850}.closing blockquote span{color:var(--cyan)}.closing p{max-width:650px;margin:24px auto 0;color:var(--muted);line-height:1.75;font-size:13px}.closing .main-site-button{display:inline-flex;margin-top:30px;padding:14px 18px;color:#021016;background:var(--cyan);text-decoration:none;border-radius:12px;font-weight:900;font-size:12px}footer{padding:26px 0 38px;border-top:1px solid #162c39;color:#6e8596;font-size:10px}.footer-row{display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap}.footer-row a{color:#9fe9f7;text-decoration:none}.lightbox{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.95)}.lightbox.open{display:flex}.lightbox img{display:block;max-width:96vw;max-height:92vh;width:auto;height:auto;object-fit:contain;background:#fff;border-radius:8px}.lightbox-close{position:absolute;top:18px;right:18px;width:46px;height:46px;border-radius:50%;border:1px solid #496374;background:#08121a;color:#fff;font-size:25px;cursor:pointer}@media(max-width:1100px){.learning-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:900px){.wrap{width:min(var(--max),calc(100% - 28px))}.proof-nav .wrap{min-height:58px;gap:10px}.brand{font-size:10px}.navlinks a,.site-link{font-size:10px;padding:7px 8px}.principles{grid-template-columns:1fr}.section-head{grid-template-columns:1fr;gap:14px}.certificate-grid,.video-grid,.evidence-grid{grid-template-columns:1fr}.back-links{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.wrap{width:calc(100% - 20px)}.hero{height:100svh;min-height:100svh}.hero img{width:100%;height:100%;object-fit:contain}.proof-nav .wrap{align-items:flex-start;padding:12px 0;flex-direction:column}.navlinks{margin-left:0;width:100%;justify-content:flex-start;overflow-x:auto;flex-wrap:nowrap;padding-bottom:2px}.navlinks a{white-space:nowrap}.intro{padding:62px 0 46px}.intro h1{font-size:44px}section.content-section{padding:44px 0 66px}.learning-grid{grid-template-columns:1fr}.learning-card{min-height:auto}.certificate-copy{padding:15px 15px 18px}.certificate-copy h3{font-size:19px}.back-links{grid-template-columns:1fr}.closing{padding:66px 0 80px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}